FROM rust:1.88 AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY blueteam/ blueteam/

# Build the blue team observer agent
RUN cargo build --release -p blueteam-agent

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/blueteam-agent /usr/local/bin/blueteam-agent

EXPOSE 5000 9101

ENTRYPOINT ["blueteam-agent"]
