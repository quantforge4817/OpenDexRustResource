[Unit]
Description=OpenDex Test Node 2
After=network.target opendex-bootstrap.service

[Service]
Type=simple
User=opendex
Group=opendex
ExecStart=/home/opendex/opendex/target/release/p2p-node \
  --port 4003 \
  --peer /ip4/127.0.0.1/tcp/4001/p2p/__BOOTSTRAP_PEER_ID__ \
  --monero-rpc http://127.0.0.1:18082 \
  --btc-rpc http://127.0.0.1:18332
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opendex-testnode2

[Install]
WantedBy=multi-user.target
