[Unit]
Description=OpenDex Test Node 2
After=network.target opendex-bootstrap.service monero-wallet-rpc.service

[Service]
Type=simple
User=opendex
Group=opendex
ExecStart=__P2P_BINARY__ \
  --port 4003 \
  --peer /ip4/127.0.0.1/tcp/4001/p2p/__BOOTSTRAP_PEER_ID__ \
  --monero-rpc http://127.0.0.1:18083/json_rpc \
  --btc-rpc http://127.0.0.1:18332 \
  --btc-rpc-user opendex \
  --btc-rpc-pass opendex_testnet
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opendex-testnode2

[Install]
WantedBy=multi-user.target
