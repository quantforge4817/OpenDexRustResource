[Unit]
Description=OpenDex Bootstrap Node
After=network.target monero-stagenet.service bitcoin-testnet.service monero-wallet-rpc.service

[Service]
Type=simple
User=opendex
Group=opendex
ExecStart=__P2P_BINARY__ \
  --port 4001 \
  --monero-rpc http://127.0.0.1:18083/json_rpc \
  --btc-rpc http://127.0.0.1:18332 \
  --btc-rpc-user opendex \
  --btc-rpc-pass opendex_testnet
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opendex-bootstrap

[Install]
WantedBy=multi-user.target
