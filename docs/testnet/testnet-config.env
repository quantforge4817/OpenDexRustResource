# Testnet Configuration
# Centralized environment variables for all testnet services

# --- P2P Node Configuration ---
BOOTSTRAP_PORT=4001
TESTNODE1_PORT=4002
TESTNODE2_PORT=4003
LISTEN_ADDRESS=127.0.0.1

# Bootstrap node peer ID — filled in by setup-nodes.sh after identity generation
# BOOTSTRAP_PEER_ID=12D3...

# --- Monero Stagenet Configuration ---
MONERO_NETWORK=stagenet
MONERO_RPC_PORT=18082
MONERO_P2P_PORT=18089
MONERO_DATA_DIR=/home/monero/.bitmonero/stagenet
MONERO_RPC_URL=http://127.0.0.1:18082

# --- Bitcoin Testnet Configuration ---
BTC_NETWORK=testnet
BTC_RPC_PORT=18332
BTC_P2P_PORT=18333
BTC_DATA_DIR=/home/bitcoin/.bitcoin/testnet3
BTC_RPC_URL=http://127.0.0.1:18332

# --- User Configuration ---
OPENDEX_USER=opendex
MONERO_USER=monero
BITCOIN_USER=bitcoin
OPENDEX_HOME=/home/opendex
OPENDEX_BINARY=/home/opendex/opendex/target/release/p2p-node

# --- Web Frontend Configuration ---
WEB_DOMAIN=localhost
WEB_ROOT=/var/www/opendex
